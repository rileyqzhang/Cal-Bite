{
  "expo": {
    "name": "Berkeley Dining",
    "slug": "berkeley-dining",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "berkeleydining",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#003262",
          "defaultChannel": "daily-favorites"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.berkeley-dining",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.anonymous.berkeleydining",
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    }
  }
}
